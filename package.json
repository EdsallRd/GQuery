{
  "name": "@edsallrd/gquery",
  "version": "2.0.0-beta.0",
  "main": "dist/bundle.js",
  "module": "dist/bundle.js",
  "types": "dist/bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "author": "Edsall Park <https://github.com/EdsallRd>",
  "repository": {
    "type": "git",
    "url": "https://github.com/EdsallRd/gquery.git"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "package:smoke": "node scripts/package-smoke.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run package:smoke"
  },
  "dependencies": {
    "@types/google-apps-script": "^2.0.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.40.2",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "vitest": "^4.1.9"
  },
  "type": "module"
}
